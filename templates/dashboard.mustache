{{!
    @template local_craftoffice/dashboard

    CraftOffice Dashboard Template.

    Context variables required for this template:
    * mycraftoffice - Title string for central dashboard
    * craftofficedesc - Description string
    * docs - Array of document objects
}}
<div class="craftoffice-dashboard">
    <!-- Header Toolbar -->
    <div class="craftoffice-toolbar">
        <div>
            <h2><i class="fa fa-folder-open"></i> {{#str}} mycraftoffice, local_craftoffice {{/str}}</h2>
            <p class="text-muted">{{#str}} craftofficedesc, local_craftoffice {{/str}}</p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="{{new_writer_url}}" class="btn btn-primary">
                <i class="fa fa-file-text-o"></i> {{#str}} newwriter, local_craftoffice {{/str}}
            </a>
            <a href="{{new_calc_url}}" class="btn btn-success">
                <i class="fa fa-table"></i> {{#str}} newcalc, local_craftoffice {{/str}}
            </a>
            <a href="{{new_pdf_url}}" class="btn btn-danger">
                <i class="fa fa-file-pdf-o"></i> {{#str}} newpdf, local_craftoffice {{/str}}
            </a>
            <a href="{{new_deck_url}}" class="btn btn-warning" style="color: #fff; background-color: #e67e22; border-color: #d35400;">
                <i class="fa fa-desktop"></i> {{#str}} newdeck, local_craftoffice {{/str}}
            </a>
        </div>
    </div>

    <!-- Main Layout with Sidebar and Content Area -->
    <div class="craftoffice-layout">
        <!-- Sidebar Navigation (Folders & Categories) -->
        <div class="craftoffice-sidebar">
            <div class="craftoffice-sidebar-title">{{#str}} folders, local_craftoffice {{/str}}</div>
            <ul class="craftoffice-nav-list">
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link active" onclick="filterCategory('all', this)">
                        <span><i class="fa fa-folder"></i> {{#str}} allfolders, local_craftoffice {{/str}}</span>
                        <span class="badge badge-secondary">{{count_all}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('text', this)">
                        <span><i class="fa fa-file-text-o" style="color: #1b6ec2;"></i> WordCraft</span>
                        <span class="badge badge-primary">{{count_writer}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('spreadsheet', this)">
                        <span><i class="fa fa-table" style="color: #107c41;"></i> GridCraft</span>
                        <span class="badge badge-success">{{count_calc}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('pdf', this)">
                        <span><i class="fa fa-file-pdf-o" style="color: #d83b01;"></i> PdfCraft</span>
                        <span class="badge badge-danger">{{count_pdf}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('presentation', this)">
                        <span><i class="fa fa-desktop" style="color: #e67e22;"></i> DeckCraft</span>
                        <span class="badge badge-warning" style="color: #fff; background-color: #e67e22;">{{count_deck}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item" style="margin-top: 15px;">
                    <div class="craftoffice-sidebar-title">{{#str}} accesslevel, local_craftoffice {{/str}}</div>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('access_public', this)">
                        <span><i class="fa fa-globe"></i> {{#str}} publicdocs, local_craftoffice {{/str}}</span>
                        <span class="badge badge-info">{{count_public}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('access_shared', this)">
                        <span><i class="fa fa-users"></i> {{#str}} shareddocs, local_craftoffice {{/str}}</span>
                        <span class="badge badge-warning" style="background-color: #fd7e14; color: #fff;">{{count_shared}}</span>
                    </a>
                </li>
                <li class="craftoffice-nav-item">
                    <a class="craftoffice-nav-link" onclick="filterCategory('access_private', this)">
                        <span><i class="fa fa-lock"></i> {{#str}} privatedocs, local_craftoffice {{/str}}</span>
                        <span class="badge badge-dark">{{count_private}}</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Right Content Area: Search Bar, View Mode Toggle, Grid & List Views -->
        <div class="craftoffice-content">
            <!-- Controls Bar: Search & View Toggle -->
            <div class="craftoffice-controls">
                <div class="craftoffice-search-box">
                    <i class="fa fa-search"></i>
                    <input type="text" id="craftoffice-search" placeholder="{{#str}} searchdocs, local_craftoffice {{/str}}" onkeyup="searchDocuments()">
                </div>
                <div class="craftoffice-view-toggle">
                    <button id="btn-view-grid" class="craftoffice-view-btn active" onclick="switchViewMode('grid')">
                        <i class="fa fa-th-large"></i> {{#str}} cardview, local_craftoffice {{/str}}
                    </button>
                    <button id="btn-view-list" class="craftoffice-view-btn" onclick="switchViewMode('list')">
                        <i class="fa fa-list"></i> {{#str}} listview, local_craftoffice {{/str}}
                    </button>
                </div>
            </div>

            {{#has_docs}}
                <!-- 1. Grid / Card View Mode -->
                <div id="craftoffice-view-grid-container" class="craftoffice-grid">
                    {{#docs}}
                        <div class="craftoffice-card doc-item"
                             data-type="{{norm_type}}"
                             data-access="{{accesslevel}}"
                             data-title="{{lower_title}}"
                             data-author="{{lower_author}}">
                            <div>
                                <div class="craftoffice-card-header">
                                    <div class="craftoffice-icon {{icon_class}}">{{icon_symbol}}</div>
                                    <div>
                                        <a href="{{editor_url}}" class="craftoffice-card-title">
                                            {{title}}
                                        </a>
                                        <div class="badge badge-secondary" style="margin-top: 4px; display: inline-block;">{{type_label}}</div>
                                    </div>
                                </div>
                                <div class="craftoffice-meta">
                                    <div><i class="fa fa-user"></i> {{author_name}}</div>
                                    <div><i class="fa fa-clock-o"></i> {{modified_date}}</div>
                                </div>
                            </div>
                            <div class="craftoffice-actions">
                                <a href="{{editor_url}}" class="btn btn-sm btn-outline-primary" title="{{#str}} open, local_craftoffice {{/str}}">
                                    <i class="fa fa-edit"></i> {{#str}} open, local_craftoffice {{/str}}
                                </a>
                                {{#doc_file_url}}
                                    <a href="{{doc_file_url}}" download class="btn btn-sm btn-outline-success" title="Baixar Cópia">
                                        <i class="fa fa-download"></i>
                                    </a>
                                {{/doc_file_url}}
                                <a href="{{edit_url}}" class="btn btn-sm btn-outline-secondary" title="{{#str}} config, local_craftoffice {{/str}}">
                                    <i class="fa fa-cog"></i>
                                </a>
                                <a href="{{duplicate_url}}" class="btn btn-sm btn-outline-info" title="{{#str}} duplicate, local_craftoffice {{/str}}">
                                    <i class="fa fa-copy"></i>
                                </a>
                                {{#can_delete}}
                                    <a href="{{delete_url}}" class="btn btn-sm btn-outline-danger" onclick="return confirm('{{#str}} confirmdelete, local_craftoffice {{/str}}');" title="{{#str}} delete {{/str}}">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                {{/can_delete}}
                            </div>
                        </div>
                    {{/docs}}
                </div>

                <!-- 2. Detailed List View Mode -->
                <div id="craftoffice-view-list-container" style="display: none;">
                    <table class="craftoffice-list-table">
                        <thead>
                            <tr>
                                <th style="width: 40px;"></th>
                                <th>{{#str}} coltitle, local_craftoffice {{/str}}</th>
                                <th>{{#str}} coltype, local_craftoffice {{/str}}</th>
                                <th>{{#str}} colauthor, local_craftoffice {{/str}}</th>
                                <th>{{#str}} colaccess, local_craftoffice {{/str}}</th>
                                <th>{{#str}} colmodified, local_craftoffice {{/str}}</th>
                                <th style="text-align: right;">{{#str}} colactions, local_craftoffice {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#docs}}
                                <tr class="doc-item"
                                    data-type="{{norm_type}}"
                                    data-access="{{accesslevel}}"
                                    data-title="{{lower_title}}"
                                    data-author="{{lower_author}}">
                                    <td>
                                        <div class="craftoffice-icon {{icon_class}}" style="width: 28px; height: 28px; font-size: 13px;">{{icon_symbol}}</div>
                                    </td>
                                    <td>
                                        <a href="{{editor_url}}" style="font-weight: 600; color: #333;">
                                            {{title}}
                                        </a>
                                    </td>
                                    <td><span class="badge badge-secondary">{{type_label}}</span></td>
                                    <td>{{author_name}}</td>
                                    <td><small class="text-muted">{{access_label}}</small></td>
                                    <td><small class="text-muted">{{modified_date}}</small></td>
                                    <td style="text-align: right;">
                                        <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                            <a href="{{editor_url}}" class="btn btn-sm btn-outline-primary" title="{{#str}} open, local_craftoffice {{/str}}">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            {{#doc_file_url}}
                                                <a href="{{doc_file_url}}" download class="btn btn-sm btn-outline-success" title="Baixar Cópia">
                                                    <i class="fa fa-download"></i>
                                                </a>
                                            {{/doc_file_url}}
                                            <a href="{{edit_url}}" class="btn btn-sm btn-outline-secondary" title="{{#str}} config, local_craftoffice {{/str}}">
                                                <i class="fa fa-cog"></i>
                                            </a>
                                            <a href="{{duplicate_url}}" class="btn btn-sm btn-outline-info" title="{{#str}} duplicate, local_craftoffice {{/str}}">
                                                <i class="fa fa-copy"></i>
                                            </a>
                                            {{#can_delete}}
                                                <a href="{{delete_url}}" class="btn btn-sm btn-outline-danger" onclick="return confirm('{{#str}} confirmdelete, local_craftoffice {{/str}}');" title="{{#str}} delete {{/str}}">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            {{/can_delete}}
                                        </div>
                                    </td>
                                </tr>
                            {{/docs}}
                        </tbody>
                    </table>
                </div>
            {{/has_docs}}

            {{^has_docs}}
                <div class="alert alert-info text-center" style="padding: 40px; margin-top: 20px;">
                    <h4>{{#str}} nodocs, local_craftoffice {{/str}}</h4>
                    <p>{{#str}} nodocsdesc, local_craftoffice {{/str}}</p>
                </div>
            {{/has_docs}}
        </div>
    </div>
</div>
