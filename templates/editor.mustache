{{!
    @template local_craftoffice/editor

    CraftOffice Editor View Template.

    Context variables required for this template:
    * title - Document title
    * app_label - Application label name
    * canvas_id - WASM Canvas element ID
    * can_edit - Boolean edit permission
    * stored_file_url - File storage URL
}}
<div class="craftoffice-editor-wrapper" style="width: 100%; height: calc(100vh - 40px); display: flex; flex-direction: column;">
    <div class="craftoffice-editor-header" style="background: #1e1e1e; color: #fff; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <strong>{{title}}</strong>
            <span class="badge badge-info">{{app_label}}</span>

            <!-- Live Presence & Active Editors Badge -->
            <span id="craftoffice-presence-badge" class="badge badge-success" style="background-color: #28a745; color: #fff; font-weight: normal;" title="Verificando editores ativos...">
                <i class="fa fa-circle"></i> Editando (Você)
            </span>

            {{^can_edit}}
                <span class="badge badge-warning" style="background-color: #ffc107; color: #000;">
                    <i class="fa fa-eye"></i> {{#str}} readonlymode, local_craftoffice {{/str}}
                </span>
            {{/can_edit}}
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <span id="craftoffice-status" style="color: #28a745; font-size: 13px;"></span>

            {{#stored_file_url}}
                <!-- Direct File Download Button from Moodle File Storage API (mdl_files) -->
                <a href="{{stored_file_url}}" download class="btn btn-sm btn-outline-success" style="color: #28a745; border-color: #28a745;">
                    <i class="fa fa-download"></i> Baixar Arquivo
                </a>
            {{/stored_file_url}}

            {{#can_edit}}
                <!-- Direct File Upload Button into Moodle File Storage API (mdl_files) -->
                <input type="file" id="craftoffice-file-input" style="display: none;" onchange="uploadDirectFile(this)">
                <button class="btn btn-sm btn-outline-light" onclick="document.getElementById('craftoffice-file-input').click();">
                    <i class="fa fa-upload"></i> {{#str}} uploadfile, local_craftoffice {{/str}}
                </button>
            {{/can_edit}}

            <a href="{{back_url}}" class="btn btn-sm btn-outline-light">
                <i class="fa fa-arrow-left"></i> {{#str}} back, local_craftoffice {{/str}}
            </a>
        </div>
    </div>

    <div id="craftoffice-editor-container" style="flex: 1; position: relative; background: #2d2d2d; overflow: hidden;">
        <canvas id="{{canvas_id}}" style="width: 100%; height: 100%; display: block;"></canvas>
        <div id="wordcraft_loading" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: rgba(0,0,0,0.85); font-family: sans-serif;">
            <h3>{{#str}} loading, local_craftoffice {{/str}} {{app_label}}...</h3>
            <p style="color: #aaa; font-size: 14px;">{{#str}} initializingwasm, local_craftoffice {{/str}}</p>
        </div>
    </div>
</div>
